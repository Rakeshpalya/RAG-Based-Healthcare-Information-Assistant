    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Layered Cache Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2 } }
      },
      "gridPos": { "h": 6, "w": 16, "x": 0, "y": 6 },
      "id": 7,
      "title": "Cache Hits vs Cache Misses",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(rag_cache_hits_total[1m])", "legendFormat": "Hits / sec", "refId": "A" },
        { "expr": "rate(rag_cache_misses_total[1m])", "legendFormat": "Misses / sec", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "max": 1, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "green", "value": 0.6 }] }, "unit": "percentunit" }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "id": 8,
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "targets": [{ "expr": "(rag_cache_hits_total / (rag_cache_hits_total + rag_cache_misses_total)) or vector(0)", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 102,
      "title": "Latency Analysis (p50 / p95 / p99)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "id": 9,
      "title": "End-to-End Request Latency Percentiles",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50 (median)", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "id": 10,
      "title": "Subsystem Latency: FAISS Retrieval vs LLM Generation",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_duration_seconds_bucket[5m])) by (le))", "legendFormat": "FAISS Retrieval p95", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(rag_llm_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Gemini Generation p95", "refId": "B" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
