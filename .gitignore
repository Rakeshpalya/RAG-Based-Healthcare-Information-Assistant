# Python virtual environment
venv/
.venv/
ENV/
env/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Environment variables
.env

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE files
.vscode/
.idea/
*.swp

# Data files (keep placeholders)
data/documents/*
!data/documents/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/vector_store/*
