!data/vector_store/index.faiss
!data/vector_store/metadata.json

# Operating system
.DS_Store
Thumbs.db

# Secrets, certificates, and databases
*.pem
*.key
*.cert
*.crt
*.db
*.sqlite
*.sqlite3

# Node modules & frontend artifacts
node_modules/
dist/
build/

# Scratch & temporary files
scratch/
tmp/
