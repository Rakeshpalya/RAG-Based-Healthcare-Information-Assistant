# ==============================================================================
# AI-Healthcare-Agent: Environment Configuration Template (.env.example)
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit real credentials, passwords, or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
APP_NAME=AI Healthcare Research & Patient Assistance Agent
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 2. Google Gemini LLM Settings (Required for clinical answer generation)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 3. Optional OpenAI Settings (for conversational medical chatbot router)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. RAG Retrieval & Similarity Settings
# ------------------------------------------------------------------------------
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
RAG_LATENCY_P95_BUDGET_MS=3500.0

# ------------------------------------------------------------------------------
# 5. Relational Database Settings (PostgreSQL / Supabase)
# For local Docker Compose: postgresql://postgres:postgres@postgres:5432/ai_healthcare
# For remote Supabase: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_healthcare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_healthcare

# ------------------------------------------------------------------------------
# 6. Supabase Client Settings (Optional, for GoTrue JWT authentication)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 7. Quality Evaluation & Observability Directories
# ------------------------------------------------------------------------------
EVALUATION_DATA_DIR=tests/evaluation_data
EVALUATION_REPORTS_DIR=evaluation_reports

# --------------------------------------------------------
# 8. LLM Response Cache Settings (Phase 3.3)
# --------------------------------------------------------
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=1000
PROMPT_VERSION=v3.3

# --------------------------------------------------------
# 9. Concurrency, Timeouts & Rate Limits (Phase 3.4)
# --------------------------------------------------------
RATE_LIMIT_ENABLED=true
GENERAL_REQUESTS_PER_MINUTE=30
STREAMING_REQUESTS_PER_MINUTE=10
MAX_CONCURRENT_LLM_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=60.0
LLM_TIMEOUT_SECONDS=30.0

# --------------------------------------------------------
# 10. Redis Distributed Cache & Shared State (Phase 3.5)
# --------------------------------------------------------
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true
